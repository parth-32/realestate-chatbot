# OpenRouter API Key for AI Concierge (Optional: Can also be entered by users in UI Settings)
OPENROUTER_API_KEY=

# Default Free Model (Options: minimax/minimax-m3:free, nvidia/nemotron-3.5-lightning:free, liquid/lfm-2.5-2.6b:free)
DEFAULT_MODEL=minimax/minimax-m3:free

# Optional: External FastAPI Backend URL (leave empty to use Next.js native serverless API routes on Vercel)
# BACKEND_URL=https://your-backend.railway.app
